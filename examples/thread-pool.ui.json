{
  "version": "gen-ui-demo/v1",
  "title": "Java 线程池配置器",
  "description": "拖动滑块观察演示公式，最大线程数 = 核心线程数 × 2，非生产通用推荐值。",
  "controls": [
    {
      "id": "core",
      "type": "slider",
      "label": "核心线程数",
      "min": 1,
      "max": 16,
      "step": 1,
      "value": 4
    }
  ],
  "metrics": [
    {
      "label": "核心线程数",
      "source": "core",
      "multiplier": 1,
      "suffix": " 线程"
    },
    {
      "label": "最大线程数（示例）",
      "source": "core",
      "multiplier": 2,
      "suffix": " 线程"
    }
  ],
  "note": "实际线程池容量还需考虑任务类型、队列容量、拒绝策略及压测结果。"
}
